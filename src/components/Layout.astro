---
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';
import SEO from './SEO.astro';

const meta = Astro.props.meta || {};
---

<style>
  /* GLOBAL SANS-SERIF FONT FOR NAV + EVERYTHING */
  html, body, nav, nav *, main, footer, footer *, * {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
      Roboto, Helvetica, Arial, sans-serif;
  }
</style>

<html lang="en">
  <head>
    <SEO {...meta} />
  </head>

  <body style="background:#120016; margin:0; color:#f2e9ff;">
    <SiteNav />

    <main style="max-width:900px; margin:40px auto; padding:20px;">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>






