---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SYMBOLS } from '../../data/symbols.js';
export async function getStaticPaths() {
  return SYMBOLS.map((s) => ({ params: { slug: s.slug }, props: { symbol: s } }));
}
const { symbol } = Astro.props;

// schema objects...
---
<style>
  nav[aria-label="Breadcrumb"] ol {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
    display: flex;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  nav[aria-label="Breadcrumb"] a {
    color: #ffffff;
    text-decoration: none;
  }
  nav[aria-label="Breadcrumb"] a:hover {
    text-decoration: underline;
  }
  nav[aria-label="Breadcrumb"] li {
    color: #ffffff;
  }
</style>

<BaseLayout
  title={symbol.name + " Dream Meaning - Symbols, Archetypes and Interpretations"}
  description={"What does dreaming of a " + symbol.name.toLowerCase() + " mean? " + symbol.tagline + ". Explore the symbolic, psychological, and archetypal meanings."}
  schema={[term, bc, faq]}
>

  <nav aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/dream-symbols">Dream Symbols</a></li>
      <li aria-current="page">{symbol.name}</li>
    </ol>
  </nav>

  <article>
    <!-- rest of your page -->
  </article>

</BaseLayout>



