---
import BaseLayout from "../layouts/BaseLayout.astro";

const responses = [
  "The symbol you seek is already moving toward you.",
  "A hidden pattern is forming beneath recent events.",
  "Your dream is asking you to look twice at something familiar.",
  "The answer is not distant — it is repeating softly.",
  "A shift in your inner landscape is preparing new meaning.",
  "Your unconscious is gathering symbols for a future insight.",
  "Something forgotten is trying to return to your attention.",
  "The dream is not about the image — it is about the feeling beneath it.",
  "Your intuition already knows the direction; the dream is confirmation.",
  "A symbolic doorway is opening in your nightly visions.",
  "The message is gentle, but persistent — listen again tonight.",
  "Your dream is echoing a pattern from your waking life.",
  "The symbol appears when your mind is ready to interpret it.",
  "A quiet truth is rising from your unconscious.",
  "Your dream is weaving together past and present meaning.",
  "The symbol is a guide, not a destination.",
  "Your inner world is preparing you for a transition.",
  "The dream is pointing toward something you have not named yet.",
  "A deeper layer of your psyche is beginning to speak.",
  "Your dream is a mirror — but not of the surface.",
  "The symbol carries a message about your next emotional step.",
  "Your unconscious is offering clarity disguised as mystery.",
  "The meaning will reveal itself when you stop searching for it.",
  "Your dream is a rehearsal for something real.",
  "The symbol is asking you to pause and reflect.",
  "Your intuition is stronger than the dream itself.",
  "A new archetype is entering your symbolic life.",
  "Your dream is the beginning of a longer conversation.",
  "The symbol is a visitor — welcome it.",
  "Your unconscious is aligning something important.",
  "The dream is a threshold — step through gently.",
  "Your symbol is a compass, not a map.",
  "The meaning is already forming — trust the process."
];
<script is:raw>
function getRandomResponse() {
  const index = Math.floor(Math.random() * responses.length);
  return responses[index];
}

const initialResponse = getRandomResponse();
---

<BaseLayout
  title="The Seer — Your Symbolic Oracle"
  description="Ask The Seer for symbolic insight into dreams, relationships, and life events."
>
  <style>
/* Make the Seer responsive */
.seer-container {
  max-width: 700px;
  width: 100%;
  margin: 4rem auto;
  padding: 2rem;
  box-sizing: border-box;
}

.seer-glyph {
  font-size: 4rem;
}

.seer-input {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  font-size: 1rem;
}

.seer-button {
  width: 100%;
  max-width: 280px;
  margin: 0 auto;
  display: block;
}

.seer-response {
  font-size: 1.3rem;
  line-height: 1.6;
}

/* Mobile responsiveness */
@media (max-width: 600px) {
  .seer-container {
    padding: 1.5rem;
    margin-top: 2rem;
  }

  .seer-glyph {
    font-size: 3rem;
  }

  .seer-input {
    font-size: 0.95rem;
    padding: 0.85rem;
  }

  .seer-button {
    font-size: 0.95rem;
    padding: 0.65rem 1.25rem;
  }

  .seer-response {
    font-size: 1.1rem;
  }
}

/* Make the Seer responsive */
.seer-container {
  max-width: 700px;
  width: 100%;
  margin: 4rem auto;
  padding: 2rem;
  box-sizing: border-box;
}

.seer-input {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.seer-button {
  width: 100%;
  max-width: 280px;
  margin: 0 auto;
  display: block;
}

@media (max-width: 600px) {
  .seer-container {
    padding: 1.5rem;
    margin-top: 2rem;
  }

  .seer-glyph {
    font-size: 3rem;
  }

  .seer-response {
    font-size: 1.1rem;
  }
}

    .seer-container {
      max-width: 700px;
      margin: 4rem auto;
      text-align: center;
      padding: 2rem;
    }

    .seer-glyph {
      font-size: 4rem;
      margin-bottom: 1rem;
      color: #c4b5fd;
      filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.4));
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .seer-input {
      width: 100%;
      padding: 1rem;
      border-radius: 10px;
      border: 1px solid rgba(167, 139, 250, 0.3);
      background: rgba(45, 21, 84, 0.4);
      color: #e8e0ff;
      font-size: 1rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(10px);
    }

    .seer-button {
      padding: 0.75rem 1.5rem;
      border-radius: 10px;
      background: #a78bfa;
      color: #120016;
      font-weight: bold;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .seer-button:hover {
      background: #c4b5fd;
    }

    .seer-response {
      margin-top: 2rem;
      font-size: 1.3rem;
      color: #e8e0ff;
      opacity: 0;
      animation: fadeIn 1.5s forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  </style>

  <div class="seer-container">
    <div class="seer-glyph">🔮</div>

    <h1 style="font-family: 'Cinzel', serif; color: #d8c8ff; margin-bottom: 1rem;">
      The Seer
    </h1>

    <p style="color: #a78bfa; margin-bottom: 2rem;">
      Ask your question. The Seer will answer with symbolic insight.
    </p>

    <input
      id="seerInput"
      class="seer-input"
      type="text"
      placeholder="Ask The Seer about a dream, symbol, or situation..."
    />

    <button class="seer-button" onclick="generateSeerResponse()">
      Reveal Insight
    </button>

    <div id="seerResponse" class="seer-response">
      {initialResponse}
    </div>
  </div>

  <script>
    function generateSeerResponse() {
      const responses = [
        "The symbol you seek is already moving toward you.",
        "A hidden pattern is forming beneath recent events.",
        "Your dream is asking you to look twice at something familiar.",
        "The answer is not distant — it is repeating softly.",
        "A shift in your inner landscape is preparing new meaning.",
        "Your unconscious is gathering symbols for a future insight.",
        "Something forgotten is trying to return to your attention.",
        "The dream is not about the image — it is about the feeling beneath it.",
        "Your intuition already knows the direction; the dream is confirmation.",
        "A symbolic doorway is opening in your nightly visions.",
        "The message is gentle, but persistent — listen again tonight.",
        "Your dream is echoing a pattern from your waking life.",
        "The symbol appears when your mind is ready to interpret it.",
        "A quiet truth is rising from your unconscious.",
        "Your dream is weaving together past and present meaning.",
        "The symbol is a guide, not a destination.",
        "Your inner world is preparing you for a transition.",
        "The dream is pointing toward something you have not named yet.",
        "A deeper layer of your psyche is beginning to speak.",
        "Your dream is a mirror — but not of the surface.",
        "The symbol carries a message about your next emotional step.",
        "Your unconscious is offering clarity disguised as mystery.",
        "The meaning will reveal itself when you stop searching for it.",
        "Your dream is a rehearsal for something real.",
        "The symbol is asking you to pause and reflect.",
        "Your intuition is stronger than the dream itself.",
        "A new archetype is entering your symbolic life.",
        "Your dream is the beginning of a longer conversation.",
        "The symbol is a visitor — welcome it.",
        "Your unconscious is aligning something important.",
        "The dream is a threshold — step through gently.",
        "Your symbol is a compass, not a map.",
        "The meaning is already forming — trust the process."
      ];

      const index = Math.floor(Math.random() * responses.length);
      const response = responses[index];

      const output = document.getElementById("seerResponse");
      output.style.opacity = 0;

      setTimeout(() => {
        output.textContent = response;
        output.style.animation = "fadeIn 1.5s forwards";
      }, 300);
    }
  </script>

</BaseLayout>




