---
import BaseLayout from "../layouts/BaseLayout.astro";

const responses = [
  "The symbol you seek is already moving toward you.",
  "A hidden pattern is forming beneath recent events.",
  "Your dream is asking you to look twice at something familiar.",
  "The answer is not distant — it is repeating softly.",
  "A shift in your inner landscape is preparing new meaning.",
  "Your unconscious is gathering symbols for a future insight.",
  "Something forgotten is trying to return to your attention.",
  "The dream is not about the image — it is about the feeling beneath it.",
  "Your intuition already knows the direction; the dream is confirmation.",
  "A symbolic doorway is opening in your nightly visions.",
  "The message is gentle, but persistent — listen again tonight.",
  "Your dream is echoing a pattern from your waking life.",
  "The symbol appears when your mind is ready to interpret it.",
  "A quiet truth is rising from your unconscious.",
  "Your dream is weaving together past and present meaning.",
  "The symbol is a guide, not a destination.",
  "Your inner world is preparing you for a transition.",
  "The dream is pointing toward something you have not named yet.",
  "A deeper layer of your psyche is beginning to speak.",
  "Your dream is a mirror — but not of the surface.",
  "The symbol carries a message about your next emotional step.",
  "Your unconscious is offering clarity disguised as mystery.",
  "The meaning will reveal itself when you stop searching for it.",
  "Your dream is a rehearsal for something real.",
  "The symbol is asking you to pause and reflect.",
  "Your intuition is stronger than the dream itself.",
  "A new archetype is entering your symbolic life.",
  "Your dream is the beginning of a longer conversation.",
  "The symbol is a visitor — welcome it.",
  "Your unconscious is aligning something important.",
  "The dream is a threshold — step through gently.",
  "Your symbol is a compass, not a map.",
  "The meaning is already forming — trust the process."
];
---

<BaseLayout title="The Seer" description="Ask The Seer for symbolic insight.">
  <style>
    /* Container */
    .seer-container {
      max-width: 720px;
      width: 100%;
      margin: 4rem auto;
      padding: 2.5rem 2rem 3rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    /* Cosmic background ambiance */
    .seer-container::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 0%, rgba(80, 0, 120, 0.4), transparent 70%),
                  radial-gradient(circle at 50% 100%, rgba(20, 0, 40, 0.5), transparent 70%);
      filter: blur(40px);
      opacity: 0.7;
      pointer-events: none;
    }

    /* Drifting fog */
    .seer-container::after {
      content: "";
      position: absolute;
      inset: -40%;
      background: radial-gradient(circle at 20% 0%, rgba(255,255,255,0.06), transparent 55%),
                  radial-gradient(circle at 80% 100%, rgba(167,139,250,0.08), transparent 60%);
      opacity: 0.5;
      filter: blur(18px);
      pointer-events: none;
      animation: fogDrift 26s linear infinite;
      mix-blend-mode: screen;
    }

    @keyframes fogDrift {
      0% { transform: translate3d(-10px, 0, 0); }
      50% { transform: translate3d(10px, -8px, 0); }
      100% { transform: translate3d(-10px, 0, 0); }
    }

    /* Starfield container */
    .stars {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    /* Star layers */
    .star, .star2, .star3 {
      position: absolute;
      background: rgba(255,255,255,0.8);
      border-radius: 50%;
      pointer-events: none;
    }

    .star {
      width: 2px;
      height: 2px;
      animation: starDrift 14s linear infinite;
    }

    .star2 {
      width: 3px;
      height: 3px;
      animation: starDrift2 18s linear infinite;
      opacity: 0.7;
    }

    .star3 {
      width: 1px;
      height: 1px;
      animation: starDrift3 9s linear infinite;
      opacity: 0.9;
    }

    @keyframes starDrift {
      0% { transform: translateY(0); opacity: 0.8; }
      100% { transform: translateY(50px); opacity: 0.2; }
    }

    @keyframes starDrift2 {
      0% { transform: translateY(0); opacity: 0.7; }
      100% { transform: translateY(70px); opacity: 0.1; }
    }

    @keyframes starDrift3 {
      0% { transform: translateY(0); opacity: 1; }
      100% { transform: translateY(30px); opacity: 0.3; }
    }

    /* Sacred Eye (Oculus Aura) */
    .seer-eye {
      width: 200px;
      height: 200px;
      margin: 0 auto 1.5rem;
      position: relative;
      border-radius: 50%;
      background: radial-gradient(circle at 50% 50%, #0d0710 0%, #1a0f1f 40%, #000 70%);
      box-shadow:
        0 0 80px rgba(120, 0, 160, 0.6),
        0 0 140px rgba(40, 0, 80, 0.7),
        inset 0 0 40px rgba(0,0,0,0.8);
      animation: eyeFloat 7s ease-in-out infinite;
    }

    @keyframes eyeFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    /* Golden iris */
    .seer-eye::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 140px;
      height: 140px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background:
        radial-gradient(circle at 50% 50%, #d4a63f 0%, #8a5a12 40%, #3a1f3f 70%),
        radial-gradient(circle at 30% 30%, rgba(255,200,120,0.25), transparent 60%),
        radial-gradient(circle at 70% 60%, rgba(255,255,255,0.15), transparent 70%);
      opacity: 0.9;
      box-shadow:
        inset 0 0 50px rgba(0,0,0,0.7),
        inset 0 0 20px rgba(255,255,255,0.2);
    }

    /* Nebula swirl */
    .seer-eye::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 160px;
      height: 160px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background:
        radial-gradient(circle at 40% 40%, rgba(120,0,160,0.4), transparent 60%),
        radial-gradient(circle at 70% 60%, rgba(200,120,255,0.3), transparent 70%),
        radial-gradient(circle at 50% 50%, rgba(255,255,255,0.1), transparent 80%);
      mix-blend-mode: screen;
      opacity: 0.6;
      animation: nebulaPulse 9s ease-in-out infinite, nebulaRotate 22s linear infinite;
    }

    @keyframes nebulaPulse {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.8; }
    }

    @keyframes nebulaRotate {
      0% { transform: translate(-50%, -50%) rotate(0deg); }
      100% { transform: translate(-50%, -50%) rotate(360deg); }
    }

    /* Pupil */
    .seer-pupil {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 42px;
      height: 42px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: #000;
      box-shadow: 0 0 25px rgba(0,0,0,0.9);
      animation: pupilPulse 6s ease-in-out infinite;
    }

    @keyframes pupilPulse {
      0%, 100% { width: 42px; height: 42px; }
      50% { width: 50px; height: 50px; }
    }

    /* Title */
    .seer-title {
      font-family: "Cinzel", serif;
      color: #e5ddff;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 1.6rem;
      margin-bottom: 0.75rem;
    }

    .seer-subtitle {
      color: #a78bfa;
      font-size: 1rem;
      max-width: 520px;
      margin: 0 auto 2.25rem;
      line-height: 1.6;
    }

    /* Input */
    .seer-input {
      width: 100%;
      padding: 1.2rem;
      border-radius: 12px;
      border: 1px solid rgba(167,139,250,0.45);
      background: rgba(30,10,60,0.75);
      color: #e8e0ff;
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(12px);
      text-align: center;

  margin: 0 auto;
}
display: block;
margin-left: auto;
margin-right: auto;
    }

    /* Button */
    .seer-button {
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
      padding: 1rem 1.6rem;
      border-radius: 999px;
      background: radial-gradient(circle at 20% 0%, #f5f3ff, #c4b5fd 40%, #7c3aed 100%);
      color: #120016;
      font-weight: 600;
      border: none;
      cursor: pointer;
      display: block;
      font-size: 1rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* Listening shimmer */
    .seer-listening {
      margin-top: 1.4rem;
      font-size: 0.9rem;
      color: rgba(199,181,255,0.8);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0;
    }

    .seer-listening.active {
      opacity: 1;
      animation: shimmer 2.4s ease-in-out infinite;
    }

    @keyframes shimmer {
      0% { opacity: 0.15; }
      50% { opacity: 0.9; }
      100% { opacity: 0.2; }
    }

    /* Response */
    .seer-response {
      margin-top: 2rem;
      padding: 1.1rem 1rem;
      min-height: 70px;
      border-radius: 14px;
      border: 1px solid rgba(167,139,250,0.5);
      background: rgba(24,16,48,0.95);
      color: #e8e0ff;
      font-size: 1.15rem;
      line-height: 1.7;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }

    .seer-response.active {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <div class="seer-container">

    <!-- Starfield -->
    <div class="stars">
      <div class="star" style="top:5%; left:15%; animation-delay:0s;"></div>
      <div class="star" style="top:18%; left:70%; animation-delay:1s;"></div>
      <div class="star" style="top:40%; left:30%; animation-delay:2s;"></div>
      <div class="star" style="top:60%; left:85%; animation-delay:3s;"></div>
      <div class="star" style="top:75%; left:10%; animation-delay:4s;"></div>

      <div class="star2" style="top:12%; left:50%; animation-delay:0.5s;"></div>
      <div class="star2" style="top:35%; left:80%; animation-delay:1.5s;"></div>
      <div class="star2" style="top:55%; left:25%; animation-delay:2.5s;"></div>
      <div class="star2" style="top:78%; left:60%; animation-delay:3.5s;"></div>

      <div class="star3" style="top:22%; left:40%; animation-delay:0.2s;"></div>
      <div class="star3" style="top:48%; left:15%; animation-delay:0.8s;"></div>
      <div class="star3" style="top:68%; left:75%; animation-delay:1.2s;"></div>
    </div>

    <!-- Sacred Eye -->
    <div class="seer-eye">
      <div class="seer-pupil"></div>
    </div>

    <h1 class="seer-title">The Seer</h1>

    <p class="seer-subtitle">
      Ask your question. The Sacred Eye listens beneath symbols, dreams, and identity.
    </p>

    <input
      id="seerInput"
      class="seer-input"
      type="text"
      placeholder="Type your question here..."
      onkeydown="if(event.key==='Enter'){ generateSeerResponse(); }"
    />

    <button class="seer-button" onclick="generateSeerResponse()">
      Ask The Seer
    </button>

    <div id="seerListening" class="seer-listening">
      The Seer is listening...
    </div>

    <div id="seerResponse" class="seer-response"></div>
  </div>

  <script is:raw>
    function generateSeerResponse() {
      const responses = [
        "The symbol you seek is already moving toward you.",
        "A hidden pattern is forming beneath recent events.",
        "Your dream is asking you to look twice at something familiar.",
        "The answer is not distant — it is repeating softly.",
        "A shift in your inner landscape is preparing new meaning.",
        "Your unconscious is gathering symbols for a future insight.",
        "Something forgotten is trying to return to your attention.",
        "The dream is not about the image — it is about the feeling beneath it.",
        "Your intuition already knows the direction; the dream is confirmation.",
        "A symbolic doorway is opening in your nightly visions.",
        "The message is gentle, but persistent — listen again tonight.",
        "Your dream is echoing a pattern from your waking life.",
        "The symbol appears when your mind is ready to interpret it.",
        "A quiet truth is rising from your unconscious.",
        "Your dream is weaving together past and present meaning.",
        "The symbol is a guide, not a destination.",
        "Your inner world is preparing you for a transition.",
        "The dream is pointing toward something you have not named yet.",
        "A deeper layer of your psyche is beginning to speak.",
        "Your dream is a mirror — but not of the surface.",
        "The symbol carries a message about your next emotional step.",
        "Your unconscious is offering clarity disguised as mystery.",
        "The meaning will reveal itself when you stop searching for it.",
        "Your dream is a rehearsal for something real.",
        "The symbol is asking you to pause and reflect.",
        "Your intuition is stronger than the dream itself.",
        "A new archetype is entering your symbolic life.",
        "Your dream is the beginning of a longer conversation.",
        "The symbol is a visitor — welcome it.",
        "Your unconscious is aligning something important.",
        "The dream is a threshold — step through gently.",
        "Your symbol is a compass, not a map.",
        "The meaning is already forming — trust the process."
      ];

      const input = document.getElementById("seerInput");
      const listening = document.getElementById("seerListening");
      const output = document.getElementById("seerResponse");

      listening.classList.add("active");
      output.classList.remove("active");

      const response = responses[Math.floor(Math.random() * responses.length)];

      setTimeout(() => {
        listening.classList.remove("active");
        output.textContent = response;
        output.classList.add("active");
      }, 900);
    }
  </script>
</BaseLayout>








