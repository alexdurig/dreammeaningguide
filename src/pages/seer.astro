---
const seerSayings = [
  "The images that return are not accidents; they are invitations.",
  "You do not dream in words, yet your dreams speak in sentences.",
  "Every symbol you resist has already chosen you.",
  "The dream is not a story you watch; it is a mirror you enter.",
  "You are not here to decode the dream. You are here to let it rearrange you."
];

function getRandomSaying() {
  return seerSayings[Math.floor(Math.random() * seerSayings.length)];
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>The Seer · DreamMeaningGuide</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      :root {
        --bg-deep: #050514;
        --bg-chamber: #0b0718;
        --fg: #e9e3ff;
        --accent-purple: #6A4BFF;
        --accent-soft: #C7B3FF;
        --accent-gold: #f3c97a;
        --accent-glow: #9D7FFF;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 20% 0%, #1a1633 0, #050514 55%),
          radial-gradient(circle at 80% 100%, #120a24 0, #050514 60%);
        color: var(--fg);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      main {
        width: 100%;
        max-width: 1040px;
        padding: 3.5rem 1.5rem 4.5rem;
      }

      .seer-shell {
        border-radius: 24px;
        background: radial-gradient(circle at 50% 0%, #1b1436 0, #080513 60%);
        box-shadow:
          0 0 40px rgba(0, 0, 0, 0.8),
          0 0 80px rgba(106, 75, 255, 0.35);
        border: 1px solid rgba(243, 201, 122, 0.18);
        padding: 2.5rem 2rem 2.75rem;
        position: relative;
        overflow: hidden;
      }

      .seer-shell::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        border: 1px solid rgba(199, 179, 255, 0.18);
        pointer-events: none;
      }

      .seer-header {
        text-align: center;
        margin-bottom: 2.5rem;
        position: relative;
      }

      .seer-title-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
      }

      .seer-moon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #ffffff 0, #d7cfff 40%, #8f7fff 100%);
        box-shadow: 0 0 18px rgba(199, 179, 255, 0.7);
      }

      .seer-title {
        font-size: 2.4rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent-soft);
      }

      .seer-subtitle {
        margin-top: 0.9rem;
        font-size: 1rem;
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
        color: #b9b1e8;
      }

      .seer-divider {
        margin: 1.8rem auto 0;
        width: 160px;
        height: 1px;
        background: linear-gradient(
          to right,
          rgba(243, 201, 122, 0),
          rgba(243, 201, 122, 0.7),
          rgba(243, 201, 122, 0)
        );
      }

      .seer-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr);
        gap: 2.5rem;
        margin-top: 2.5rem;
      }

      @media (max-width: 840px) {
        .seer-layout {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ORACLE COLUMN */

      .seer-oracle {
        position: relative;
        height: 360px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .seer-oracle-inner {
        position: relative;
        animation: seer-bob 7s ease-in-out infinite;
      }

      .seer-svg {
        filter:
          drop-shadow(0 0 18px rgba(157, 127, 255, 0.45))
          drop-shadow(0 0 40px rgba(106, 75, 255, 0.35));
      }

      @keyframes seer-bob {
        0%   { transform: translateY(0px); }
        25%  { transform: translateY(-10px); }
        50%  { transform: translateY(0px); }
        75%  { transform: translateY(8px); }
        100% { transform: translateY(0px); }
      }

      /* Star field */

      .seer-stars {
        position: absolute;
        inset: -10%;
        pointer-events: none;
      }

      .seer-star {
        position: absolute;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #ffffff;
        opacity: 0;
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
        animation: star-fade 7s ease-in-out infinite;
      }

      .seer-star:nth-child(1) { top: 8%;  left: 18%; animation-delay: 0.4s; }
      .seer-star:nth-child(2) { top: 22%; left: 78%; animation-delay: 1.1s; }
      .seer-star:nth-child(3) { top: 40%; left: 10%; animation-delay: 2.0s; }
      .seer-star:nth-child(4) { top: 60%; left: 86%; animation-delay: 3.2s; }
      .seer-star:nth-child(5) { top: 75%; left: 30%; animation-delay: 4.4s; }
      .seer-star:nth-child(6) { top: 18%; left: 52%; animation-delay: 5.3s; }
      .seer-star:nth-child(7) { top: 50%; left: 65%; animation-delay: 1.8s; }
      .seer-star:nth-child(8) { top: 68%; left: 12%; animation-delay: 2.7s; }
      .seer-star:nth-child(9) { top: 32%; left: 90%; animation-delay: 0.9s; }
      .seer-star:nth-child(10){ top: 85%; left: 55%; animation-delay: 3.9s; }

      @keyframes star-fade {
        0%   { opacity: 0; transform: scale(0.7); }
        25%  { opacity: 0.35; transform: scale(1); }
        50%  { opacity: 0.15; transform: scale(0.9); }
        75%  { opacity: 0.4; transform: scale(1.05); }
        100% { opacity: 0; transform: scale(0.7); }
      }

      /* INTERACTION COLUMN */

      .seer-panel {
        background: radial-gradient(circle at 0% 0%, #1c1436 0, #0b0718 55%);
        border-radius: 18px;
        border: 1px solid rgba(243, 201, 122, 0.25);
        box-shadow: 0 0 24px rgba(0, 0, 0, 0.7);
        padding: 1.75rem 1.5rem 1.9rem;
        position: relative;
      }

      .seer-panel::before {
        content: "";
        position: absolute;
        inset: 10px;
        border-radius: 14px;
        border: 1px dashed rgba(199, 179, 255, 0.25);
        pointer-events: none;
      }

      .seer-panel-title {
        font-size: 1.1rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-soft);
        margin-bottom: 0.75rem;
      }

      .seer-panel-sub {
        font-size: 0.9rem;
        color: #cbc4f3;
        margin-bottom: 1.4rem;
      }

      .seer-input {
        width: 100%;
        min-height: 90px;
        border-radius: 12px;
        border: 1px solid rgba(199, 179, 255, 0.35);
        background: rgba(5, 5, 20, 0.85);
        color: var(--fg);
        padding: 0.75rem 0.9rem;
        font-size: 0.95rem;
        resize: vertical;
        outline: none;
      }

      .seer-input::placeholder {
        color: #7f76b5;
      }

      .seer-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.9rem;
      }

      .seer-button {
        border-radius: 999px;
        border: 1px solid rgba(243, 201, 122, 0.7);
        background: radial-gradient(circle at 30% 0%, #f3c97a 0, #b27bff 40%, #6a4bff 100%);
        color: #120a24;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.55rem 1.4rem;
        cursor: pointer;
        box-shadow:
          0 0 12px rgba(243, 201, 122, 0.6),
          0 0 24px rgba(106, 75, 255, 0.5);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      .seer-button:hover {
        transform: translateY(-1px);
        box-shadow:
          0 0 16px rgba(243, 201, 122, 0.8),
          0 0 30px rgba(106, 75, 255, 0.7);
      }

      .seer-button:active {
        transform: translateY(1px);
        box-shadow:
          0 0 10px rgba(243, 201, 122, 0.6),
          0 0 20px rgba(106, 75, 255, 0.5);
      }

      .seer-output-shell {
        margin-top: 1.6rem;
        border-radius: 14px;
        border: 1px solid rgba(199, 179, 255, 0.35);
        background: radial-gradient(circle at 100% 0%, #241a42 0, #0b0718 60%);
        padding: 1rem 1rem 1.1rem;
        position: relative;
        overflow: hidden;
      }

      .seer-output-label {
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(199, 179, 255, 0.8);
        margin-bottom: 0.4rem;
      }

      .seer-output-text {
        font-size: 0.95rem;
        line-height: 1.7;
        color: #e3ddff;
        min-height: 2.4rem;
      }

      .seer-output-text span {
        opacity: 0;
        display: inline-block;
      }

      .seer-output-text span.revealed {
        opacity: 1;
        transition: opacity 0.08s ease;
      }

      .seer-output-glow {
        position: absolute;
        inset: -40%;
        background: radial-gradient(circle, rgba(106, 75, 255, 0.18) 0, transparent 60%);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.8s ease;
      }

      .seer-output-shell.active .seer-output-glow {
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="seer-shell">
        <header class="seer-header">
          <div class="seer-title-row">
            <div class="seer-moon"></div>
            <h1 class="seer-title">The Seer</h1>
          </div>
          <p class="seer-subtitle">
            A quiet oracle at the center of DreamMeaningGuide—an eye that breathes, five uneven rays of meaning
            descending into your night, and a chamber that listens before it speaks.
          </p>
          <div class="seer-divider"></div>
        </header>

        <div class="seer-layout">
          <!-- ORACLE COLUMN -->
          <section class="seer-oracle" aria-label="The Seer symbol">
            <div class="seer-stars">
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
              <div class="seer-star"></div>
            </div>

            <div class="seer-oracle-inner">
              <svg class="seer-svg" width="240" height="280" viewBox="0 0 240 280" xmlns="http://www.w3.org/2000/svg">
                <!-- Pupil (lunar purple) -->
                <circle cx="120" cy="90" r="14" fill="#6A4BFF" />

                <!-- Outer Eye Arc -->
                <path d="M40 90 Q120 20 200 90 Q120 160 40 90Z"
                      fill="none" stroke="#6A4BFF" stroke-width="9" stroke-linecap="round" />

                <!-- Inner Iris Ring -->
                <circle cx="120" cy="90" r="36"
                        fill="none" stroke="#C7B3FF" stroke-width="6" />

                <!-- Five uneven dotted rays (DreamMeaningGuide aura) -->
                <line x1="120" y1="108" x2="120" y2="230"
                      stroke="#6A4BFF" stroke-width="7"
                      stroke-dasharray="8 18" stroke-linecap="round" />

                <line x1="120" y1="108" x2="98" y2="215"
                      stroke="#6A4BFF" stroke-width="7"
                      stroke-dasharray="8 18" stroke-linecap="round" />

                <line x1="120" y1="108" x2="142" y2="250"
                      stroke="#6A4BFF" stroke-width="7"
                      stroke-dasharray="8 18" stroke-linecap="round" />

                <line x1="120" y1="108" x2="80" y2="235"
                      stroke="#6A4BFF" stroke-width="7"
                      stroke-dasharray="8 18" stroke-linecap="round" />

                <line x1="120" y1="108" x2="170" y2="220"
                      stroke="#6A4BFF" stroke-width="7"
                      stroke-dasharray="8 18" stroke-linecap="round" />
              </svg>
            </div>
          </section>

          <!-- INTERACTION COLUMN -->
          <section class="seer-panel">
            <h2 class="seer-panel-title">Offer a dream to the chamber</h2>
            <p class="seer-panel-sub">
              Describe a single image, scene, or feeling from your dream. The Seer will not explain it away;
              it will offer a sentence that lets the symbol keep breathing.
            </p>

            <textarea
              id="seer-input"
              class="seer-input"
              placeholder="For example: I was walking through a flooded library, and every book was humming softly."
            ></textarea>

            <div class="seer-actions">
              <button id="seer-button" class="seer-button" type="button">
                Listen to The Seer
              </button>
            </div>

            <div id="seer-output-shell" class="seer-output-shell">
              <div class="seer-output-glow"></div>
              <div class="seer-output-label">The Seer replies</div>
              <div id="seer-output-text" class="seer-output-text"></div>
            </div>
          </section>
        </div>
      </section>

      <script>
        const sayings = JSON.parse(`${JSON.stringify(seerSayings)}`);

        const inputEl = document.getElementById("seer-input");
        const buttonEl = document.getElementById("seer-button");
        const outputShellEl = document.getElementById("seer-output-shell");
        const outputTextEl = document.getElementById("seer-output-text");

        function pickSaying() {
          return sayings[Math.floor(Math.random() * sayings.length)];
        }

        function revealText(text) {
          outputTextEl.innerHTML = "";
          const chars = text.split("");
          chars.forEach((ch) => {
            const span = document.createElement("span");
            span.textContent = ch;
            outputTextEl.appendChild(span);
          });

          const spans = Array.from(outputTextEl.querySelectorAll("span"));
          let i = 0;

          function step() {
            if (i >= spans.length) return;
            spans[i].classList.add("revealed");
            i++;
            const delay = 22 + Math.random() * 40;
            setTimeout(step, delay);
          }

          step();
        }

        buttonEl.addEventListener("click", () => {
          const userText = (inputEl.value || "").trim();

          outputShellEl.classList.add("active");
          outputTextEl.innerHTML = "";

          const base = pickSaying();
          const prefix = userText
            ? "The image you offered is already working on you. "
            : "Even without a description, your night has been speaking. ";

          const full = prefix + base;

          setTimeout(() => {
            revealText(full);
          }, 420);
        });
      </script>
    </main>
  </body>
</html>









