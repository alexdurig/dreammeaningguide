---
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SYMBOLS } from '../../data/symbols.js';

const categories = [
  { slug: "animals",    icon: "🐺", label: "Animals",    desc: "Instinct, shadow, spirit, and primal wisdom." },
  { slug: "places",     icon: "🌲", label: "Places",     desc: "Inner landscapes reflected in outer settings." },
  { slug: "emotions",   icon: "💜", label: "Emotions",   desc: "Amplified feelings from the unconscious mind." },
  { slug: "archetypes", icon: "✦",  label: "Archetypes", desc: "Universal figures from the collective unconscious." },
];

const grouped = {
  animals: SYMBOLS.filter(s => s.category === "Animals"),
  places: SYMBOLS.filter(s => s.category === "Places"),
  emotions: SYMBOLS.filter(s => s.category === "Emotions"),
  archetypes: SYMBOLS.filter(s => s.category === "Archetypes"),
};
---

<style>
  body {
    background: radial-gradient(circle at top, #2b0f4a, #0f0a1a);
    color: #e8e0ff;
    font-family: Inter, sans-serif;
    margin: 0;
    padding: 0;
  }

  .category-card {
    background: rgba(45,21,84,0.55);
    border: 1px solid rgba(167,139,250,0.18);
    border-radius: 1.25rem;
    padding: 2rem 1.5rem;
    text-align: center;
    color: #e8e0ff;
    transition: all 0.22s ease;
    backdrop-filter: blur(12px);
    cursor: default;
  }

  .card-label {
    font-family: Inter, sans-serif, serif;
    font-size: 1.1rem;
    color: #f5eaff;
    display: block;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.85rem;
    color: #e8e0ff;
    line-height: 1.6;
  }
</style>

<SiteNav currentPath={Astro.url.pathname} />

<main style="max-width:900px;margin:0 auto;padding:3rem 2rem;">

  <h1>Dream Symbols</h1>

  <p style="text-align:center;color:#a78bfa;margin-bottom:3rem;font-size:1rem;">
    Choose a category to explore, or search all symbols below.
  </p>

  <div style="text-align:center;margin-bottom:2.5rem;">
    <input id="symbol-search" type="text" placeholder="Search symbols..."
      style="width:80%;padding:0.8rem;border-radius:6px;border:1px solid #6a4bcf;background:#1a1330;color:#e8e0ff;font-size:1rem;"
      oninput="filterSymbols()" />
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1.25rem;margin-bottom:3rem;">
    {categories.map(cat => (
      <div class="category-card">
        <span style="font-size:2.5rem;display:block;margin-bottom:0.75rem;">{cat.icon}</span>
        <span class="card-label">{cat.label}</span>
        <span class="card-desc">{cat.desc}</span>
      </div>
    ))}
  </div>

  <div id="symbols-container">
    {Object.keys(grouped).map(cat => (
      <div>
        <h2 style="font-family:Inter, sans-serif;font-size:1.6rem;color:#cbb4ff;border-bottom:1px solid #6a4bcf;
                   padding-bottom:0.3rem;margin-bottom:1rem;margin-top:2rem;">
          {cat.charAt(0).toUpperCase() + cat.slice(1)}
        </h2>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;">
          {grouped[cat].map(symbol => (
            <div style="background:#1a1330;border:1px solid #6a4bcf;padding:1rem;border-radius:8px;text-align:center;
                        transition:transform 0.3s ease,background 0.3s ease;cursor:pointer;">
              <a href={`/dream-symbols/${symbol.slug}`} style="color:#e8e0ff;text-decoration:none;">
                {symbol.name}
              </a>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

</main>

<SiteFooter />

<script>
  function filterSymbols() {
    const query = document.getElementById("symbol-search").value.toLowerCase();
    document.querySelectorAll("#symbols-container div").forEach(item => {
      item.style.display = item.textContent.toLowerCase().includes(query) ? "block" : "none";
    });
  }
</script>





