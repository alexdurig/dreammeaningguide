---
import Layout from '../components/Layout.astro';
---

<Layout title="The Seer">

<style>
  /* UNIVERSAL FONT FIX — GUARANTEED SANS-SERIF */
  .seer-page,
  .seer-page * {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
      Roboto, Helvetica, Arial, sans-serif;
  }

  .seer-page {
    padding: 2rem;
  }

  .seer-page h1 {
    text-align: center;
    color: white;
    margin-top: 2rem;
    font-size: 2.5rem;
  }

  .seer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }

  .seer-box {
    background: linear-gradient(180deg, #2a1a3f, #1a0f2b);
    padding: 2rem;
    border-radius: 12px;
    color: white;
  }

  .seer-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  #seer-question {
    width: 100%;
    padding: 1rem;
    border-radius: 8px;
    border: none;
    font-size: 1.1rem;
    margin-top: 1rem;
  }

  #seer-response {
    margin-top: 1rem;
    padding: 1rem;
    background: rgba(255,255,255,0.1);
    border-radius: 8px;
    min-height: 120px;
    font-size: 1.2rem;
    line-height: 1.5;
  }
</style>
<div class="seer-page">
<center> <img src="/og-theseer.png" alt="The Seer" class="home-og" /> </center>
<h2>Meet The Seer, Your Guide to Symbolic Insight 🔮</h2> 
<p>The Seer is an archetypal oracle of identity and intuition, created to help you explore dreams, relationships, and meaningful turning points through a symbolic lens.</p> 
<p>Pair The Seer with the DreamMeaningGuide symbol library, your Dream Journal, sleep tools, and identity-based Guides to create a reflective practice that grows with you.</p> 
<p>Every dream can become an invitation to understand your inner world more clearly.</p>
<p>Every question leads to an answer that is often unexpected, yet always meaningful.</p>
<ol>
<li>Explore dreams through identity and intuition</li> 
<li>Uncover emotional context behind symbols</li> 
<li>Reflect on relationships and turning points</li> 
<li>Build a meaningful dream interpretation practice</li> 
</ol>
<p>You made it here to DreamMeaningGuide.site, now ask The Seer for some symbolic insight:</p>
<p>
</p>
<h1>~The Seer~</h1>
  <div class="seer-grid">
    <div class="seer-box">
      <div class="seer-title">OFFER A DREAM TO THE SEER</div>
      <p>Describe an image, scene, or feeling from a dream and hit Enter.</p>
      <p><em>For example: I was walking through a flooded library, what could that mean?</em></p>

      <input id="seer-question" type="text" placeholder="Describe your dream..." />
    </div>

    <div class="seer-box">
      <div class="seer-title">THE SEER REPLIES</div>
      <div id="seer-response">The Seer awaits your question...</div>
    </div>

  </div>

</div>

<script>
  import('/public/seer.js').then(module => {
    const responses = module.default;

    const input = document.getElementById('seer-question');
    const output = document.getElementById('seer-response');

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const dream = input.value.trim();
        if (!dream) return;

        const reply = responses[Math.floor(Math.random() * responses.length)];
        output.textContent = reply;
      }
    });
  });
</script>

<audio id="darkdrone" src="/audio/darkdrone.mp3" loop></audio>
<audio id="dragonwind" src="/audio/dragonwind.mp3" loop></audio>

<script>
const low = document.getElementById('darkdrone');     // main drone
const air = document.getElementById('dragonwind');    // airy layer

// --- INSTANT START FOR DARKDRONE ---
low.volume = 0.15;   // immediate, no fade
low.play().catch(() => {
  document.addEventListener('click', () => low.play(), { once: true });
});

// --- FADE-IN FOR DRAGONWIND ---
air.volume = 0;
air.play().catch(() => {
  document.addEventListener('click', () => air.play(), { once: true });
});

let v = 0;
const fade = setInterval(() => {
  v += 0.01;
  air.volume = v * 0.04;   // soft airy fade-in
  if (v >= 1) clearInterval(fade);
}, 300);

// --- RANDOM AMBIENT SWELLS (living chamber) ---
setInterval(() => {
  low.volume = 0.12 + Math.random() * 0.06;  // darkdrone fluctuation
  air.volume = 0.02 + Math.random() * 0.03;  // dragonwind fluctuation
}, 30000); // every 30 seconds
</script>











