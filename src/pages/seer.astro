---

<BaseLayout title="The Seer" description="Ask The Seer for symbolic insight.">
  <style>
    .seer-container {
      max-width: 720px;
      width: 100%;
      margin: 4rem auto;
      padding: 2.5rem 2rem 3rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    /* Ambient fog */
    .seer-container::before,
    .seer-container::after {
      content: "";
      position: absolute;
      inset: -40%;
      background: radial-gradient(circle at 20% 0%, rgba(255,255,255,0.06), transparent 55%),
                  radial-gradient(circle at 80% 100%, rgba(167,139,250,0.08), transparent 60%);
      opacity: 0.6;
      filter: blur(18px);
      pointer-events: none;
      animation: fogDrift 26s linear infinite;
      mix-blend-mode: screen;
    }

    .seer-container::after {
      animation-duration: 38s;
      opacity: 0.4;
    }

    @keyframes fogDrift {
      0% { transform: translate3d(-10px, 0, 0); }
      50% { transform: translate3d(10px, -8px, 0); }
      100% { transform: translate3d(-10px, 0, 0); }
    }

    /* Golden moon with facial features */
    .seer-moon {
      width: 130px;
      height: 130px;
      margin: 0 auto 1rem;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #fff7d6 0%, #f2d98b 40%, #d4a63f 75%, #8a5a12 100%);
      box-shadow: 0 0 35px rgba(255, 230, 150, 0.7), 0 0 80px rgba(255, 200, 120, 0.8);
      position: relative;
      animation: moonBob 7s ease-in-out infinite;
    }

    @keyframes moonBob {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    /* Eyes + faint smile */
    .seer-moon::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 42%;
      width: 60px;
      height: 60px;
      transform: translateX(-50%);
      background:
        radial-gradient(circle at 35% 40%, rgba(0,0,0,0.35), transparent 55%),
        radial-gradient(circle at 65% 40%, rgba(0,0,0,0.35), transparent 55%),
        radial-gradient(circle at 50% 70%, rgba(0,0,0,0.25), transparent 60%);
      opacity: 0.45;
      border-radius: 50%;
    }

    .seer-moon::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 68%;
      width: 50px;
      height: 20px;
      transform: translateX(-50%);
      border-bottom: 2px solid rgba(0,0,0,0.35);
      border-radius: 50%;
      opacity: 0.4;
    }

    .seer-glyph {
      font-size: 3rem;
      margin-bottom: 1.25rem;
      color: #c4b5fd;
      filter: drop-shadow(0 0 22px rgba(139,92,246,0.55));
    }

    .seer-title {
      font-family: "Cinzel", serif;
      color: #e5ddff;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 1.6rem;
      margin-bottom: 0.75rem;
    }

    .seer-subtitle {
      color: #a78bfa;
      font-size: 0.98rem;
      max-width: 520px;
      margin: 0 auto 2.25rem;
      line-height: 1.6;
    }

    .seer-input {
      width: 100%;
      padding: 1.1rem;
      border-radius: 12px;
      border: 1px solid rgba(167,139,250,0.45);
      background: rgba(30,10,60,0.75);
      color: #e8e0ff;
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(12px);
    }

    .seer-button {
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
      padding: 0.9rem 1.6rem;
      border-radius: 999px;
      background: radial-gradient(circle at 20% 0%, #f5f3ff, #c4b5fd 40%, #7c3aed 100%);
      color: #120016;
      font-weight: 600;
      border: none;
      cursor: pointer;
      display: block;
      font-size: 1rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .seer-listening {
      margin-top: 1.4rem;
      font-size: 0.9rem;
      color: rgba(199,181,255,0.8);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0;
    }

    .seer-listening.active {
      opacity: 1;
      animation: shimmer 2.4s ease-in-out infinite;
    }

    @keyframes shimmer {
      0% { opacity: 0.15; }
      50% { opacity: 0.9; }
      100% { opacity: 0.2; }
    }

    .seer-response {
      margin-top: 2rem;
      padding: 1.1rem 1rem;
      min-height: 70px;
      border-radius: 14px;
      border: 1px solid rgba(167,139,250,0.5);
      background: rgba(24,16,48,0.95);
      color: #e8e0ff;
      font-size: 1.15rem;
      line-height: 1.7;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }

    .seer-response.active {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <div class="seer-container">
    <div class="seer-moon"></div>

    <div class="seer-glyph">🔮</div>

    <h1 class="seer-title">The Seer</h1>

    <p class="seer-subtitle">
      Ask your question. The Seer listens beneath symbols, dreams, and identity.
    </p>

    <input
      id="seerInput"
      class="seer-input"
      type="text"
      placeholder="Type your question here..."
      onkeydown="if(event.key==='Enter'){ generateSeerResponse(); }"
    />

    <button class="seer-button" onclick="generateSeerResponse()">
      Ask The Seer
    </button>

    <div id="seerListening" class="seer-listening">
      The Seer is listening...
    </div>

    <div id="seerResponse" class="seer-response"></div>
  </div>

