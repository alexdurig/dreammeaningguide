---
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';
import SEO from './SEO.astro';

const meta = Astro.props.meta || {};
---

<html lang="en">
  <head>
    <SEO {...meta} />
  </head>

  <body style="font-family: Georgia, serif; background:#120016; margin:0; color:#f2e9ff;">
    <SiteNav />

    <main style="max-width:900px; margin:40px auto; padding:20px;">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>





