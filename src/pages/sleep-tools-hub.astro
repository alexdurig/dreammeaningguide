---
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const pageTitle = "Sleep Tools Hub | DreamMeaningGuide";
const pageDescription = "Carefully curated sleep tools to support deeper rest, vivid dreaming, and a more connected inner life.";
---

<style>
  body {
    background: radial-gradient(circle at top, #2b0f4a, #0f0a1a);
    color: #e8e0ff;
    font-family: Inter, sans-serif;
    margin: 0;
    padding: 0;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section h2 {
    font-family: Cinzel, serif;
    font-size: 1.8rem;
    color: #d8c8ff;
    margin-bottom: 1rem;
    border-bottom: 1px solid #6a4bcf;
    padding-bottom: 0.3rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    background: rgba(45,21,84,0.55);
    border: 1px solid rgba(167,139,250,0.18);
    border-radius: 1rem;
    padding: 1.5rem;
    backdrop-filter: blur(12px);
    text-align: center;
    transition: transform 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
  }

  .product-card h3 {
    font-family: Cinzel, serif;
    font-size: 1.1rem;
    color: #f5eaff;
    margin-bottom: 0.5rem;
  }

  .product-card p {
    font-size: 0.9rem;
    color: #e8e0ff;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .product-card a {
    display: inline-block;
    background: #6a4bcf;
    color: #ffffff;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.25s ease;
  }

  .product-card a:hover {
    background: #8b6df7;
  }
</style>

<SiteNav currentPath={Astro.url.pathname} />

<main style="max-width:900px;margin:0 auto;padding:3rem 2rem;">

  <h1 style="font-family:Cinzel,serif;font-size:2.4rem;text-align:center;color:#d8c8ff;margin-bottom:1rem;">
    Sleep Tools Hub
  </h1>

  <p style="text-align:center;color:#a78bfa;margin-bottom:3rem;font-size:1rem;">
    Curated tools to deepen rest, enhance dream recall, and support your nightly inner journey.
  </p>

  <!-- Sleep Masks -->
  <section class="section">
    <h2>Sleep Masks</h2>
    <div class="product-grid">

      <div class="product-card">
        <h3>Kitsch Satin Sleep Mask</h3>
        <p>Charcoal black satin mask designed to block out light and support deeper, uninterrupted sleep.</p>
        <a href="https://amzn.to/4hOy4gD" target="_blank">View on Amazon</a>
      </div>

      <!-- Add more sleep masks here later -->
    </div>
  </section>

  <!-- Weighted Blankets -->
  <section class="section">
    <h2>Weighted Blankets</h2>
    <div class="product-grid">

      <div class="product-card">
        <h3>Weighted Blanket (Placeholder)</h3>
        <p>Calming pressure to help reduce nighttime anxiety and support deeper rest.</p>
        <a href="#" target="_blank">Affiliate Link</a>
      </div>

    </div>
  </section>

  <!-- Dream Journals -->
  <section class="section">
    <h2>Dream Journals</h2>
    <div class="product-grid">

      <div class="product-card">
        <h3>Dream Journal (Placeholder)</h3>
        <p>A dedicated space to record dreams, symbols, and nightly insights.</p>
        <a href="#" target="_blank">Affiliate Link</a>
      </div>

    </div>
  </section>

  <!-- White Noise & Sound -->
  <section class="section">
    <h2>White Noise & Sleep Sound Machines</h2>
    <div class="product-grid">

      <div class="product-card">
        <h3>Sound Machine (Placeholder)</h3>
        <p>Gentle ambient sound to help quiet the mind and ease into sleep.</p>
        <a href="#" target="_blank">Affiliate Link</a>
      </div>

    </div>
  </section>

  <!-- Supplements -->
  <section class="section">
    <h2>Sleep Supplements</h2>
    <div class="product-grid">

      <div class="product-card">
        <h3>Melatonin / Magnesium (Placeholder)</h3>
        <p>Support for natural sleep rhythms and nighttime relaxation.</p>
        <a href="#" target="_blank">Affiliate Link</a>
      </div>

    </div>
  </section>

  <!-- Lighting -->
  <section class="section">
    <h2>Bedroom Lighting</h2>
    <div class="product-grid">

      <div class="product-card">
        <h3>Soft Amber Lamp (Placeholder)</h3>
        <p>Warm, low‑blue lighting to prepare the mind for rest.</p>
        <a href="#" target="_blank">Affiliate Link</a>
      </div>

    </div>
  </section>

</main>

<SiteFooter />
